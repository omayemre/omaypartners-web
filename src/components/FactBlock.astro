---
// Project fact block: client / location / year / area under the title.
// Every field is optional and rendered only if present - a project with
// only two known facts still reads as intentional, not broken.
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  client?: string;
  location?: string;
  year?: string;
  area?: string;
  /** From the Archive's "Service Provided" column, joined by slug - only present where that row is linked. */
  service?: string;
}

const { lang, client, location, year, area, service } = Astro.props;

const labels =
  lang === 'en'
    ? { client: 'Client', location: 'Location', year: 'Year', area: 'Area', service: 'Service' }
    : { client: 'Müşteri', location: 'Yer', year: 'Yıl', area: 'Alan', service: 'Hizmet' };

const facts = [
  { label: labels.client, value: client },
  { label: labels.location, value: location },
  { label: labels.year, value: year },
  { label: labels.area, value: area },
  { label: labels.service, value: service }
].filter((f) => f.value);
---

{facts.length > 0 && (
  <div class="mx-auto mt-8 flex max-w-2xl flex-wrap justify-center gap-x-10 gap-y-4 border-t border-rule pt-6 text-center">
    {facts.map((f) => (
      <div>
        <p class="font-sans-nums text-label text-ink-45 uppercase">{f.label}</p>
        <p class="mt-1 text-table text-ink">{f.value}</p>
      </div>
    ))}
  </div>
)}
