---
import { t, type Lang } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
  translations?: Partial<Record<Lang, string>>;
}

const { lang, translations } = Astro.props;
const i18n = t(lang);
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
function isActive(href: string) {
  const normalized = href.replace(/\/$/, '') || '/';
  return pathname === normalized;
}
// A handful of TR-only projects have no EN page yet (no translations.en).
// Rather than silently falling back to '/' - which reads as a broken link
// dressed up as a working one - the toggle below renders as plain,
// non-clickable text in that case. Pages that don't wire up per-page
// translations at all (e.g. 404) still get the default home-link behaviour.
const hasEn = translations === undefined || translations.en !== undefined;
const hasTr = translations === undefined || translations.tr !== undefined;
const enHref = url(translations?.en ?? '/');
const trHref = url(translations?.tr ?? '/tr/');

// Home isn't listed - the logo already links there, so a "Home" nav item
// would be a redundant tell. Photography isn't listed either - it moved to
// the footer.
const navItems: Array<[string, string]> = [
  [i18n.nav.about, i18n.path('about')],
  [i18n.nav.selectedWorks, i18n.path('selectedWorks')],
  [i18n.nav.howWeDeliver, i18n.path('howWeDeliver')],
  [i18n.nav.references, i18n.path('references')],
  [i18n.nav.contact, i18n.path('contact')]
];
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-[clamp(24px,5vw,96px)] py-4">
    <a href={i18n.path('home')} class="flex items-center gap-2 opacity-100 hover:opacity-70">
      <img src={url('/images/site/brand/logo-dark.webp')} alt="Omay Partners" width="307" height="61" class="h-[52px] w-auto" />
    </a>

    <nav class="font-sans-nums hidden items-center gap-6 text-[14px] font-medium md:flex">
      {navItems.map(([label, href]) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class={`nav-link relative pb-1 ${isActive(href) ? 'text-ink after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:bg-accent' : 'text-ink-60 hover:text-accent'}`}
        >
          {label}
        </a>
      ))}
      <div class="flex items-center gap-1.5 border border-rule px-2 py-1">
        {hasEn ? (
          <a href={enHref} class={lang === 'en' ? 'font-semibold text-ink' : 'text-ink-45 hover:text-accent'}>EN</a>
        ) : (
          <span class="text-ink-45" aria-disabled="true">EN</span>
        )}
        <span class="text-ink-45">/</span>
        {hasTr ? (
          <a href={trHref} class={lang === 'tr' ? 'font-semibold text-ink' : 'text-ink-45 hover:text-accent'}>TR</a>
        ) : (
          <span class="text-ink-45" aria-disabled="true">TR</span>
        )}
      </div>
    </nav>

    <details class="relative md:hidden">
      <summary class="list-none cursor-pointer p-2 text-ink" aria-label={i18n.nav.menuLabel}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </summary>
      <nav class="font-sans-nums absolute right-0 mt-2 w-56 border border-rule bg-paper py-2">
        {navItems.map(([label, href]) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class={`block px-4 py-2 text-label ${isActive(href) ? 'text-ink font-semibold' : 'text-ink-60 hover:text-accent'}`}
          >
            {label}
          </a>
        ))}
        <div class="flex items-center gap-2 px-4 py-2 text-label">
          {hasEn ? (
            <a href={enHref} class={lang === 'en' ? 'font-semibold text-ink' : 'text-ink-45 hover:text-accent'}>EN</a>
          ) : (
            <span class="text-ink-45" aria-disabled="true">EN</span>
          )}
          <span class="text-ink-45">/</span>
          {hasTr ? (
            <a href={trHref} class={lang === 'tr' ? 'font-semibold text-ink' : 'text-ink-45 hover:text-accent'}>TR</a>
          ) : (
            <span class="text-ink-45" aria-disabled="true">TR</span>
          )}
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  // <details>/<summary> has no built-in Escape or outside-tap dismissal.
  const menu = document.querySelector<HTMLDetailsElement>('header details');
  if (menu) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) menu.open = false;
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
