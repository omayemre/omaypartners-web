---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { projectImage } from '../lib/img';
import type { Lang } from '../lib/i18n';

interface Props {
  projects: CollectionEntry<'projects'>[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const base = lang === 'en' ? '' : '/tr';
---

<div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
  {projects.map((project) => {
    const cover = project.data.cover && projectImage(project.data.cover);
    return (
      <a href={url(`${base}/${project.data.slug}/`)} class="block hover:opacity-80">
        {cover && (
          <img
            src={cover.src}
            srcset={cover.srcset}
            sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            alt={project.data.title}
            width={cover.width ?? 900}
            height={cover.height ?? 600}
            class="aspect-[3/2] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        )}
        <h2 class="mt-4 text-h3">{project.data.title}</h2>
      </a>
    );
  })}
</div>
