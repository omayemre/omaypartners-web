---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import type { Lang } from '../lib/i18n';

interface Props {
  projects: CollectionEntry<'projects'>[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const base = lang === 'en' ? '' : '/tr';
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {projects.map((project) => (
    <a href={url(`${base}/${project.data.slug}/`)} class="omay-tile group block overflow-hidden">
      {project.data.cover && (
        <div class="overflow-hidden shadow-md">
          <img
            src={url(project.data.cover)}
            alt={project.data.title}
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
          />
        </div>
      )}
      <h3 class="mt-4 text-lg">{project.data.title}</h3>
    </a>
  ))}
</div>
