---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import type { Lang } from '../lib/i18n';

interface Props {
  projects: CollectionEntry<'projects'>[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const base = lang === 'en' ? '' : '/tr';
---

<div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
  {projects.map((project) => (
    <a href={url(`${base}/${project.data.slug}/`)} class="omay-tile group block hover:opacity-80">
      {project.data.cover && (
        <img
          src={url(project.data.cover)}
          alt={project.data.title}
          class="aspect-[3/2] w-full object-cover"
        />
      )}
      <h2 class="mt-4 text-h3">{project.data.title}</h2>
    </a>
  ))}
</div>
