---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = t(lang);
const year = new Date().getFullYear();
---

<footer class="bg-[#1a2233] text-white">
  <div class="px-6 py-6 text-center text-xs text-white/40">
    <a href={i18n.path('visum')} class="tracking-wide uppercase hover:text-white/70">{i18n.nav.visum}</a>
    <p class="mt-2">© {year} Omay Partners. {i18n.footer.rights}</p>
  </div>
</footer>
