---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = t(lang);
const year = new Date().getFullYear();
---

<footer class="bg-[#1a2233] text-white">
  <div class="px-6 py-6 text-center text-xs text-white/40">
    © {year} Omay Partners. {i18n.footer.rights}
  </div>
</footer>
