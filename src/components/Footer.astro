---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = t(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-rule">
  <div class="font-sans-nums mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-8 text-center text-label text-ink-30">
    <a href={i18n.path('visum')} class="uppercase hover:text-accent">{i18n.nav.visum}</a>
    <span class="mx-3" aria-hidden="true">·</span>
    <a href="https://www.linkedin.com/in/emre-omay-1a483a2/" class="uppercase hover:text-accent" rel="noopener" target="_blank">LinkedIn</a>
    <span class="mx-3" aria-hidden="true">·</span>
    <a href="https://www.instagram.com/omaypartners/" class="uppercase hover:text-accent" rel="noopener" target="_blank">Instagram</a>
    <p class="mt-3 normal-case tracking-normal">© {year} Omay Partners. {i18n.footer.rights}</p>
  </div>
</footer>
