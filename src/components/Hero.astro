---
import { url } from '../lib/url';

interface Props {
  alt: string;
  credit?: string;
}

const { alt, credit } = Astro.props;

const base = '/images/site/hero';
const srcset = [
  `${url(`${base}/hero-1024.webp`)} 1024w`,
  `${url(`${base}/hero-1600.webp`)} 1600w`,
  `${url(`${base}/hero-2560.webp`)} 2560w`
].join(', ');
---

<section>
  <img
    src={url(`${base}/hero-1600.webp`)}
    srcset={srcset}
    sizes="100vw"
    alt={alt}
    width="2560"
    height="1620"
    class="h-[clamp(420px,72vh,860px)] w-full object-cover object-[50%_45%]"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  {credit && (
    <p class="font-sans-nums mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] pt-3 text-label text-ink-30">
      {credit}
    </p>
  )}
</section>
