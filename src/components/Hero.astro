---
// Rebuilds the WordPress "Slider Revolution" hero natively with Swiper.
// Currently seeded with the one live hero image; add more entries to
// `images` to turn it into a real multi-slide carousel later.
import { url } from '../lib/url';

interface Props {
  images?: string[];
  h1: string;
}

const { images = [url('/images/site/hero/hero.webp')], h1 } = Astro.props;
---

<section class="relative h-[70vh] min-h-[480px] overflow-hidden">
  <div class="hero-swiper swiper absolute inset-0">
    <div class="swiper-wrapper">
      {images.map((src) => (
        <div class="swiper-slide">
          <img src={src} alt="" class="h-full w-full object-cover" loading="eager" />
        </div>
      ))}
    </div>
  </div>
  <h1 class="sr-only">{h1}</h1>

  <style>
    /* Minimal Swiper layout CSS, inlined rather than imported from
       'swiper/css': this project's path has a literal "@" segment (Google
       Drive folder name) that trips up Vite's /@fs//@id/ virtual-module
       resolution for some package CSS exports in this environment. */
    .hero-swiper.swiper {
      width: 100%;
      height: 100%;
      overflow: hidden;
    }
    .hero-swiper .swiper-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      transition-property: transform;
    }
    .hero-swiper .swiper-slide {
      flex-shrink: 0;
      width: 100%;
      height: 100%;
      position: relative;
    }
    .hero-swiper.swiper-fade .swiper-slide {
      pointer-events: none;
      transition-property: opacity;
    }
    .hero-swiper.swiper-fade .swiper-slide-active {
      pointer-events: auto;
    }
  </style>

</section>

<script>
  import { Swiper } from 'swiper';
  import { Autoplay, EffectFade } from 'swiper/modules';

  const el = document.querySelector<HTMLElement>('.hero-swiper');
  if (el) {
    new Swiper(el, {
      modules: [Autoplay, EffectFade],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      loop: el.querySelectorAll('.swiper-slide').length > 1,
      autoplay: { delay: 6000, disableOnInteraction: false },
      speed: 1000,
      allowTouchMove: false
    });
  }
</script>
