---
// Rebuilds the WordPress "Slider Revolution" hero natively with Swiper.
// Currently seeded with the one live hero image; add more entries to
// `images` to turn it into a real multi-slide carousel later.
import { url } from '../lib/url';

interface Props {
  images?: string[];
  subhead: string;
  ctaLabel: string;
  ctaHref: string;
}

const { images = [url('/images/site/hero/hero.webp')], subhead, ctaLabel, ctaHref } = Astro.props;
---

<section class="relative flex h-[70vh] min-h-[480px] items-center justify-center overflow-hidden text-white">
  <div class="hero-swiper swiper absolute inset-0">
    <div class="swiper-wrapper">
      {images.map((src) => (
        <div class="swiper-slide">
          <img src={src} alt="" class="h-full w-full object-cover" loading="eager" />
        </div>
      ))}
    </div>
  </div>
  <div class="absolute inset-0 bg-[#1a2233]/50"></div>

  <style>
    /* Minimal Swiper layout CSS, inlined rather than imported from
       'swiper/css': this project's path has a literal "@" segment (Google
       Drive folder name) that trips up Vite's /@fs//@id/ virtual-module
       resolution for some package CSS exports in this environment. */
    .hero-swiper.swiper {
      width: 100%;
      height: 100%;
      overflow: hidden;
    }
    .hero-swiper .swiper-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      transition-property: transform;
    }
    .hero-swiper .swiper-slide {
      flex-shrink: 0;
      width: 100%;
      height: 100%;
      position: relative;
    }
    .hero-swiper.swiper-fade .swiper-slide {
      pointer-events: none;
      transition-property: opacity;
    }
    .hero-swiper.swiper-fade .swiper-slide-active {
      pointer-events: auto;
    }
  </style>

  <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
    <h1 class="sr-only">Omay Partners</h1>
    <p class="text-lg text-white/85 md:text-xl">{subhead}</p>
    <a
      href={ctaHref}
      class="mt-8 inline-block rounded bg-[#faf8f5] px-8 py-3 text-sm tracking-wide text-[#1a2233] uppercase transition hover:bg-white"
    >
      {ctaLabel}
    </a>
  </div>
</section>

<script>
  import { Swiper } from 'swiper';
  import { Autoplay, EffectFade } from 'swiper/modules';

  const el = document.querySelector<HTMLElement>('.hero-swiper');
  if (el) {
    new Swiper(el, {
      modules: [Autoplay, EffectFade],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      loop: el.querySelectorAll('.swiper-slide').length > 1,
      autoplay: { delay: 6000, disableOnInteraction: false },
      speed: 1000,
      allowTouchMove: false
    });
  }
</script>
