---
// Static hero plate. Was previously a Swiper carousel, but with exactly one
// live image `loop` always evaluated false and there was nothing to
// cross-fade — 73KB of carousel JS animating a single static photo. Reduced
// to a plain <img> with identical visual output. `images` still takes an
// array (only the first entry renders) so a second hero plate can be added
// later without a prop-shape change; if that happens, reintroduce a
// carousel here rather than before.
import { url } from '../lib/url';

interface Props {
  images?: string[];
  h1: string;
}

const { images = [url('/images/site/hero/hero.webp')], h1 } = Astro.props;
---

<section class="relative h-[70vh] min-h-[480px] overflow-hidden">
  <img src={images[0]} alt="" class="h-full w-full object-cover" loading="eager" decoding="async" />
  <h1 class="sr-only">{h1}</h1>
</section>
