---
import { url } from '../lib/url';

interface Props {
  alt: string;
  credit?: string;
  image: string; // base path without the size suffix, e.g. '/images/site/hero/hero-hilton'
  widths: number[]; // available derivative widths, ascending
  width: number; // intrinsic width of the largest derivative (for CLS)
  height: number; // intrinsic height of the largest derivative (for CLS)
  objectPosition?: string; // CSS object-position, tuned per photo's focal point
}

const { alt, credit, image, widths, width, height, objectPosition = '50% 45%' } = Astro.props;

const largest = widths[widths.length - 1];
const srcset = widths.map((w) => `${url(`${image}-${w}.webp`)} ${w}w`).join(', ');
---

<section>
  <img
    src={url(`${image}-${largest}.webp`)}
    srcset={srcset}
    sizes="100vw"
    alt={alt}
    width={width}
    height={height}
    style={`object-position: ${objectPosition}`}
    class="h-[clamp(420px,72vh,860px)] w-full object-cover"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  {credit && (
    <p class="font-sans-nums mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] pt-3 text-label text-ink-30">
      {credit}
    </p>
  )}
</section>
