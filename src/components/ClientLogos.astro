---
import { url } from '../lib/url';

const logos = [
  { src: '/images/site/logos/hilton.webp', alt: 'Hilton' },
  { src: '/images/site/logos/sabanci.webp', alt: 'Sabancı' },
  { src: '/images/site/logos/qatar-airways.webp', alt: 'Qatar Airways' },
  { src: '/images/site/logos/bp.webp', alt: 'BP' },
  { src: '/images/site/logos/ericsson.webp', alt: 'Ericsson' },
  { src: '/images/site/logos/aecom.webp', alt: 'AECOM' },
  { src: '/images/site/logos/udemy.webp', alt: 'Udemy' },
  { src: '/images/site/logos/cushman-wakefield.webp', alt: 'Cushman & Wakefield' },
  { src: '/images/site/logos/sandvik.webp', alt: 'Sandvik' },
  { src: '/images/site/logos/leonardo.webp', alt: 'Leonardo' },
  { src: '/images/site/logos/british-embassy.webp', alt: 'British Embassy' },
  { src: '/images/site/logos/odtu-metu.webp', alt: 'ODTÜ / METU' },
  { src: '/images/site/logos/securitas.webp', alt: 'Securitas' },
  { src: '/images/site/logos/lcdg.webp', alt: 'Lycée Charles de Gaulle' },
  { src: '/images/site/logos/odtu-teknokent.webp', alt: 'ODTÜ Teknokent' }
];
---

<div class="mx-auto grid max-w-6xl grid-cols-3 items-center gap-x-8 gap-y-10 px-6 sm:grid-cols-4 md:grid-cols-5">
  {logos.map((logo) => (
    <img
      src={url(logo.src)}
      alt={logo.alt}
      class="mx-auto h-8 w-auto object-contain opacity-70 mix-blend-multiply transition hover:opacity-100"
    />
  ))}
</div>
