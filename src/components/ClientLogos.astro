---
import { url } from '../lib/url';

// scale is relative to the shared 32px (h-8) base row height, per owner's
// review notes on individual logos reading small next to the others.
const BASE_HEIGHT = 32;

const logos = [
  { src: '/images/site/logos/sabanci.webp', alt: 'Sabancı', scale: 1 },
  { src: '/images/site/logos/hilton.webp', alt: 'Hilton', scale: 1.5 },
  { src: '/images/site/logos/qatar-airways.webp', alt: 'Qatar Airways', scale: 1 },
  { src: '/images/site/logos/bp.webp', alt: 'BP', scale: 1.5 },
  { src: '/images/site/logos/ericsson.webp', alt: 'Ericsson', scale: 1.5 },
  { src: '/images/site/logos/odtu-metu.webp', alt: 'ODTÜ / METU', scale: 1.2 },
  { src: '/images/site/logos/udemy.webp', alt: 'Udemy', scale: 1.2 },
  { src: '/images/site/logos/securitas.webp', alt: 'Securitas', scale: 1.2 },
  { src: '/images/site/logos/british-embassy.webp', alt: 'British Embassy', scale: 1.875 },
  { src: '/images/site/logos/odtu-teknokent.webp', alt: 'ODTÜ Teknokent', scale: 1.2 },
  { src: '/images/site/logos/lcdg.webp', alt: 'Lycée Charles de Gaulle', scale: 1.875 },
  { src: '/images/site/logos/aecom.svg', alt: 'AECOM', scale: 1 },
  { src: '/images/site/logos/cushman-wakefield.webp', alt: 'Cushman & Wakefield', scale: 1 },
  { src: '/images/site/logos/sandvik.webp', alt: 'Sandvik', scale: 1 },
  { src: '/images/site/logos/leonardo.webp', alt: 'Leonardo', scale: 1 },
  { src: '/images/site/logos/alstom.webp', alt: 'Alstom', scale: 1.2 },
  { src: '/images/site/logos/honeywell.webp', alt: 'Honeywell', scale: 1.8 },
  { src: '/images/site/logos/italy-embassy.webp', alt: 'Embassy of Italy', scale: 3.75 },
  { src: '/images/site/logos/fulbright.webp', alt: 'Fulbright', scale: 1.44 },
  { src: '/images/site/logos/genel-energy.webp', alt: 'Genel Energy', scale: 1.2 },
  { src: '/images/site/logos/eldorado-gold.webp', alt: 'Eldorado Gold', scale: 1.25 },
  { src: '/images/site/logos/malta-embassy.webp', alt: 'Embassy of Malta', scale: 2.625 },
  { src: '/images/site/logos/magic-lab.webp', alt: 'Magic Lab', scale: 1.5 },
  { src: '/images/site/logos/nural-aydin.webp', alt: 'Dr. Nural Aydın', scale: 3.15 },
  { src: '/images/site/logos/atom.webp', alt: 'ATOM', scale: 1.2 },
  { src: '/images/site/logos/tuprag.webp', alt: 'Tüprag', scale: 3.12 },
  { src: '/images/site/logos/limeks.webp', alt: 'Limeks', scale: 1.02 },
  { src: '/images/site/logos/magdenli.webp', alt: 'Magdenli', scale: 1.5 }
];
---

<div class="mx-auto grid max-w-6xl grid-cols-3 items-center gap-x-8 gap-y-10 px-6 sm:grid-cols-4 md:grid-cols-5">
  {logos.map((logo) => (
    <img
      src={url(logo.src)}
      alt={logo.alt}
      style={`height: ${BASE_HEIGHT * logo.scale}px`}
      class="mx-auto w-auto object-contain opacity-70 mix-blend-multiply transition hover:opacity-100"
    />
  ))}
</div>
