---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  translations?: Partial<Record<Lang, string>>;
  /** Root-relative path (as from url()) to a social-preview image. Defaults to the homepage hero. */
  image?: string;
  /** Home is implied. Pass the trail after Home when a page sits deeper
   * than one click (e.g. project pages: Selected Works > Project). Emits
   * BreadcrumbList JSON-LD; renders nothing when omitted. */
  breadcrumbs?: Array<{ name: string; path: string }>;
}

const { lang, title, description, translations, image = url('/images/site/hero/hero.webp'), breadcrumbs } = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const ogLocale = lang === 'en' ? 'en_US' : 'tr_TR';
const ogLocaleAlt = lang === 'en' ? 'tr_TR' : 'en_US';

// Explicit launch flag rather than an exact-hostname match: fails safe to
// noindex on any build unless PUBLIC_ALLOW_INDEXING=true is set. The
// GitHub Pages staging workflow never sets it; the production deploy
// (stage 2) is where this gets switched on.
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';

// Titles longer than ~60 chars truncate in a browser tab / search result.
// The brand suffix is dropped rather than the page's own title when the
// combination would run long - canonical/OG/JSON-LD already carry the
// brand name regardless.
const withSuffix = `${title} – Omay Partners`;
const fullTitle = title.includes('Omay Partners') ? title : withSuffix.length <= 60 ? withSuffix : title;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Omay Partners',
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/images/site/brand/logo-dark.webp'), Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kazım Özalp Mahallesi, Şairler Sok. No:29/4 GOP Çankaya',
    addressLocality: 'Ankara',
    addressCountry: 'TR'
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+90-532-386-24-64',
      email: 'info@omaypartners.com',
      contactType: 'sales',
      areaServed: ['TR', 'GR', 'Europe', 'Middle East', 'Asia']
    }
  ],
  // TODO: point at the studio's company LinkedIn page once one exists -
  // this is Emre Omay's personal profile, kept because it's the only
  // verified link available.
  sameAs: ['https://www.linkedin.com/in/emre-omay-1a483a2/', 'https://www.instagram.com/omaypartners/']
};

const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { name: lang === 'en' ? 'Home' : 'Ana Sayfa', path: lang === 'en' ? '/' : '/tr/' },
          ...breadcrumbs
        ].map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: new URL(url(c.path), Astro.site).href
        }))
      }
    : null;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/x-icon" href={url('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href={url('/images/site/brand/favicon-192.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={pageUrl} />
    {translations?.en && <link rel="alternate" hreflang="en" href={new URL(url(translations.en), Astro.site).href} />}
    {translations?.tr && <link rel="alternate" hreflang="tr" href={new URL(url(translations.tr), Astro.site).href} />}
    {translations?.en && <link rel="alternate" hreflang="x-default" href={new URL(url(translations.en), Astro.site).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omay Partners" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    {allowIndexing && import.meta.env.PUBLIC_ANALYTICS_DOMAIN && (
      <script
        defer
        data-domain={import.meta.env.PUBLIC_ANALYTICS_DOMAIN}
        src="https://plausible.io/js/script.js"
      />
    )}
  </head>
  <body class="bg-paper text-ink antialiased">
    <Header lang={lang} translations={translations} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
