---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  translations?: Partial<Record<Lang, string>>;
  /** Root-relative path (as from url()) to a social-preview image. Defaults to the homepage hero. */
  image?: string;
}

const { lang, title, description, translations, image = url('/images/site/hero/hero.webp') } = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const ogLocale = lang === 'en' ? 'en_US' : 'tr_TR';
const ogLocaleAlt = lang === 'en' ? 'tr_TR' : 'en_US';

// Self-gating staging guard: this build is only ever fetched at the real
// domain once DEPLOY_TARGET switches `site` away from the GitHub Pages
// preview host in astro.config.mjs, so noindex follows the host
// automatically instead of relying on someone removing a comment by hand
// before launch.
const isPreviewHost = Astro.site?.hostname !== 'www.omaypartners.com';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Omay Partners',
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/images/site/brand/logo-dark.webp'), Astro.site).href,
  sameAs: ['https://www.linkedin.com/in/emre-omay-1a483a2/', 'https://www.instagram.com/omaypartners/']
};
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {isPreviewHost && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/x-icon" href={url('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href={url('/images/site/brand/favicon-192.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <title>{title} – Omay Partners</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={pageUrl} />
    {translations?.en && <link rel="alternate" hreflang="en" href={new URL(url(translations.en), Astro.site).href} />}
    {translations?.tr && <link rel="alternate" hreflang="tr" href={new URL(url(translations.tr), Astro.site).href} />}
    {translations?.en && <link rel="alternate" hreflang="x-default" href={new URL(url(translations.en), Astro.site).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omay Partners" />
    <meta property="og:title" content={`${title} – Omay Partners`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} – Omay Partners`} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="bg-white text-ink antialiased">
    <Header lang={lang} translations={translations} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
