---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectorTabs from '../components/SectorTabs.astro';
import ProjectGrid from '../components/ProjectGrid.astro';

const projects = (await getCollection('projects', ({ data }) => data.lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  lang="en"
  title="Selected Works"
  description="Selected projects — hotels, embassies, workplaces and institutional buildings designed and delivered by Omay Partners."
  translations={{ en: '/selected-projects/', tr: '/tr/projeler/' }}
>
  <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-16 md:py-16 lg:py-[104px]">
    <h1 class="text-center text-h1">Selected Works</h1>
    <p class="mt-4 text-center text-lead text-ink-60">
      Selected projects — hotels, embassies, workplaces and institutional buildings designed and delivered by
      Omay Partners
    </p>
    <div class="mt-10">
      <SectorTabs lang="en" active="all" />
    </div>
    <div class="mt-12">
      <ProjectGrid projects={projects} lang="en" />
    </div>
  </div>
</Layout>
