---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectorTabs from '../components/SectorTabs.astro';
import ProjectGrid from '../components/ProjectGrid.astro';

const projects = (await getCollection('projects', ({ data }) => data.lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout lang="en" title="Selected Works" translations={{ en: '/selected-projects/', tr: '/tr/projeler/' }}>
  <div class="mx-auto max-w-7xl px-6 py-16">
    <h1 class="text-center text-3xl font-light md:text-4xl">Selected Works</h1>
    <p class="mt-4 text-center text-[#1a2233]/70">
      Selected projects — hotels, embassies, workplaces and institutional buildings designed and delivered by
      Omay Partners
    </p>
    <div class="mt-10">
      <SectorTabs lang="en" active="all" />
    </div>
    <div class="mt-12">
      <ProjectGrid projects={projects} lang="en" />
    </div>
  </div>
</Layout>
