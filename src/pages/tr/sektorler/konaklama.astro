---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SectorTabs from '../../../components/SectorTabs.astro';
import ProjectGrid from '../../../components/ProjectGrid.astro';

const projects = (
  await getCollection('projects', ({ data }) => data.lang === 'tr' && data.sector === 'hospitality')
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  lang="tr"
  title="Konaklama"
  description="Omay Partners tarafından tasarlanan ve hayata geçirilen otel ve konaklama projeleri."
  translations={{ en: '/sectors/hospitality/', tr: '/tr/sektorler/konaklama/' }}
>
  <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-16 md:py-16 lg:py-[104px]">
    <h1 class="text-center text-h1">Konaklama</h1>
    <p class="mt-4 text-center text-lead text-ink-60">
      Omay Partners tarafından tasarlanan ve hayata geçirilen otel ve konaklama projeleri.
    </p>
    <div class="mt-10">
      <SectorTabs lang="tr" active="hospitality" />
    </div>
    <div class="mt-12">
      <ProjectGrid projects={projects} lang="tr" />
    </div>
  </div>
</Layout>
