---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SectorTabs from '../../../components/SectorTabs.astro';
import ProjectGrid from '../../../components/ProjectGrid.astro';

const projects = (
  await getCollection('projects', ({ data }) => data.lang === 'tr' && data.sector === 'workplace')
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  lang="tr"
  title="İş Yerleri"
  description="Omay Partners tarafından tasarlanan ve hayata geçirilen ofis ve iş yeri projeleri."
  translations={{ en: '/sectors/workplace/', tr: '/tr/sektorler/is-yerleri/' }}
>
  <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-section">
    <h1 class="text-center text-h1">İş Yerleri</h1>
    <p class="mt-4 text-center text-lead text-ink-60">
      Omay Partners tarafından tasarlanan ve hayata geçirilen ofis ve iş yeri projeleri.
    </p>
    <div class="mt-10">
      <SectorTabs lang="tr" active="workplace" />
    </div>
    <div class="mt-12">
      <ProjectGrid projects={projects} lang="tr" />
    </div>
  </div>
</Layout>
