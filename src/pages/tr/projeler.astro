---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectorTabs from '../../components/SectorTabs.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';

const projects = (await getCollection('projects', ({ data }) => data.lang === 'tr')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout lang="tr" title="Seçki" translations={{ en: '/selected-projects/', tr: '/tr/projeler/' }}>
  <div class="mx-auto max-w-7xl px-6 py-16">
    <h1 class="text-center text-3xl font-light md:text-4xl">Seçki</h1>
    <p class="mt-4 text-center text-[#1a2233]/70">
      Omay Partners tarafından tasarlanan ve hayata geçirilen oteller, büyükelçilikler, iş yerleri ve kurumsal
      yapılar
    </p>
    <div class="mt-10">
      <SectorTabs lang="tr" active="all" />
    </div>
    <div class="mt-12">
      <ProjectGrid projects={projects} lang="tr" />
    </div>
  </div>
</Layout>
