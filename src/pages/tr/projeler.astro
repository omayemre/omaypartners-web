---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectorTabs from '../../components/SectorTabs.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';

const projects = (await getCollection('projects', ({ data }) => data.lang === 'tr')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  lang="tr"
  title="Seçilmiş İşler"
  description="Omay Partners tarafından tasarlanan ve hayata geçirilen oteller, büyükelçilikler, iş yerleri ve kurumsal yapılar."
  translations={{ en: '/selected-projects/', tr: '/tr/projeler/' }}
>
  <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-section">
    <h1 class="text-center text-h1">Seçilmiş İşler</h1>
    <p class="mt-4 text-center text-lead text-ink-60">
      Omay Partners tarafından tasarlanan ve hayata geçirilen oteller, büyükelçilikler, iş yerleri ve kurumsal
      yapılar
    </p>
    <div class="mt-10">
      <SectorTabs lang="tr" active="all" />
    </div>
    <div class="mt-12">
      <ProjectGrid projects={projects} lang="tr" />
    </div>
  </div>
</Layout>
