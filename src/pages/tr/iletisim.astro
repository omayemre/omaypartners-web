---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      name: 'Omay Partners — Türkiye',
      parentOrganization: { '@type': 'Organization', name: 'Omay Partners' },
      url: new URL(url('/tr/iletisim/'), Astro.site).href,
      telephone: '+90 532 386 24 64',
      email: 'info@omaypartners.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Kazım Özalp Mahallesi, Şairler Sok. No:29/4 GOP Çankaya',
        addressLocality: 'Ankara',
        addressCountry: 'TR'
      }
    },
    {
      '@type': 'LocalBusiness',
      name: 'Omay Partners — Yunanistan',
      parentOrganization: { '@type': 'Organization', name: 'Omay Partners' },
      url: new URL(url('/tr/iletisim/'), Astro.site).href,
      telephone: '+30 695 573 55 53',
      email: 'info@omaypartners.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Idipodos 31',
        addressLocality: 'Glyfada',
        postalCode: '166 75',
        addressCountry: 'GR'
      }
    }
  ]
};
---

<Layout
  lang="tr"
  title="İletişim"
  description="Omay Partners ile iletişime geçin — Ankara, Türkiye ve Glyfada, Yunanistan."
  translations={{ en: '/contact-us/', tr: '/tr/iletisim/' }}
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <article class="mx-auto max-w-3xl px-[clamp(24px,5vw,96px)] py-16 text-center md:py-16 lg:py-[104px]">
    <h1 class="sr-only">İletişim</h1>

    <div class="grid grid-cols-2 items-stretch gap-3 text-left sm:gap-6">
      <div class="flex flex-col border border-rule p-4 sm:p-8">
        <p class="font-medium text-ink">Türkiye</p>
        <p class="mt-4 text-body text-ink-60">
          Kazım Özalp Mahallesi<br />
          Şairler Sok. No:29/4 GOP Çankaya, Ankara
        </p>
        <p class="mt-4">
          <a href="tel:+905323862464" class="text-body text-ink-60 hover:text-accent">+90 532 386 24 64</a>
        </p>
      </div>
      <div class="flex flex-col border border-rule p-4 sm:p-8">
        <p class="font-medium text-ink">Yunanistan</p>
        <p class="mt-4 text-body text-ink-60">
          Idipodos 31<br />
          Glyfada 166 75<br />
          Atina
        </p>
        <p class="mt-4">
          <a href="tel:+306955735553" class="text-body text-ink-60 hover:text-accent">+30 695 573 55 53</a>
        </p>
      </div>
    </div>

    <p class="mt-8 text-lead">
      <a href="mailto:info@omaypartners.com" class="text-ink-60 hover:text-accent">info@omaypartners.com</a>
    </p>
  </article>
</Layout>
