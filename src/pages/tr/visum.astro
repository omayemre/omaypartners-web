---
import Layout from '../../layouts/Layout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { url } from '../../lib/url';

const images = Array.from({ length: 40 }, (_, i) => url(`/images/site/visum/photo-${String(i + 1).padStart(2, '0')}.webp`));
---

<Layout
  lang="tr"
  title="Fotoğraf"
  description="Omay Partners tarafından mimari fotoğraf — Ankara ve Atina."
  translations={{ en: '/visum/', tr: '/tr/visum/' }}
>
  <div class="mx-auto max-w-6xl px-[clamp(24px,5vw,96px)] py-section">
    <h1 class="text-center text-h1">Fotoğraf</h1>
    <p class="mt-4 text-center text-lead text-ink-60">Emre Omay'ın çektiği bazı fotoğraflar</p>
    <div class="mt-12">
      <PhotoGrid images={images} altPrefix="Omay Partners fotoğraf" />
    </div>
  </div>
</Layout>
