---
import Layout from '../../layouts/Layout.astro';
import ReferencesTable from '../../components/ReferencesTable.astro';
import rows from '../../data/references.tr.json';
---

<Layout lang="tr" title="Referanslar" translations={{ en: '/references/', tr: '/tr/referanslar/' }}>
  <div class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-center text-3xl font-light md:text-4xl">Projeler</h1>
    <div class="mt-12">
      <ReferencesTable rows={rows} headers={['Proje', 'Verilen Hizmet', 'Müşteri']} />
    </div>
  </div>
</Layout>
