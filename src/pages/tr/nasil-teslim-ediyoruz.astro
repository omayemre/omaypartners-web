---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';

const stages = [
  {
    name: 'Brief',
    image: '/images/site/process/01-brief.webp',
    body: 'Önce dinleriz — hedefleriniz, kullanıcılarınız, kısıtlarınız, bütçeniz ve takviminiz. Bu aşama, tasarıma başlamadan önce birlikte onayladığımız yazılı bir brief ile sona erer.'
  },
  {
    name: 'Konsept',
    image: '/images/site/process/02-concept.webp',
    body: "İlk mekânsal fikirler ve seçenekler, brief'e göre değerlendirilir. Devam etmeden önce tek bir yönü onaylarsınız."
  },
  {
    name: 'Tasarım Geliştirme',
    image: '/images/site/process/03-design-development.webp',
    body: 'Konsept; gerçek malzemelere, yüzeylere, sistemlere ve maliyetlere dönüşür — tasarımın gerçekten inşa edilebilir ve fiyatlandırılabilir hale geldiği aşama.'
  },
  {
    name: 'Uygulama Projeleri',
    image: '/images/site/process/04-construction-documents.webp',
    body: 'Doğru fiyatlandırma ve ruhsatlandırma için yeterli, detaylı çizimler ve teknik şartnameler.'
  },
  {
    name: 'İnşaat / Uygulama',
    image: '/images/site/process/05-construction.webp',
    body: 'İnşa ederiz — doğrudan ya da güvendiğiniz yüklenicileri koordine eden proje yöneticisi olarak. Her iki durumda da tasarımı yapan ekip, teslime kadar sahada kalır.'
  },
  {
    name: 'Teslim',
    image: '/images/site/process/06-handover.webp',
    body: 'Eksik/kusur tespiti, yapılan-inşa dokümantasyonu ve taşınmadan önce birlikte yapılan bir son kontrol turu.'
  }
];
---

<Layout
  lang="tr"
  title="Süreç — Brief'ten Teslime"
  description="Omay Partners bir projeyi brief'ten teslime nasıl taşır — aşamalar, sözleşmeyi kimin yürüttüğü ve sizden neye ihtiyacımız olduğu."
  translations={{ en: '/how-we-deliver/', tr: '/tr/nasil-teslim-ediyoruz/' }}
  breadcrumbs={[{ name: 'Süreç', path: '/tr/nasil-teslim-ediyoruz/' }]}
>
  <article class="mx-auto max-w-[109ch] px-[clamp(24px,5vw,96px)] py-section">
    <h1 class="text-h1">Süreç</h1>
    <p class="mt-6 max-w-[60ch] text-lead text-ink-60">
      "İlk eskizden teslime, tek ekip" çalışma biçimimizin özüdür — bu sayfa bunun pratikte ne anlama geldiğini
      açıklıyor: bir projenin geçtiği aşamalar, kimin neden sorumlu olduğu ve tasarım ile teslimatı tek çatı
      altında tutmanın sonucu neden değiştirdiği.
    </p>

    <h2 class="mt-14 text-h2">Aşamalar</h2>
    <ol class="mt-6 space-y-8">
      {stages.map((stage, i) => (
        <li class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-8">
          <div class="flex flex-1 gap-5">
            <span class="font-sans-nums shrink-0 text-table text-ink-45">{String(i + 1).padStart(2, '0')}</span>
            <div class="max-w-[60ch]">
              <h3 class="text-h3">{stage.name}</h3>
              <p class="mt-1 text-body text-ink-60">{stage.body}</p>
            </div>
          </div>
          <img
            src={url(stage.image)}
            alt=""
            width="240"
            height="300"
            class="h-auto w-[200px] max-w-full shrink-0 object-contain sm:w-[240px]"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ol>

    <h2 class="mt-14 text-h2">Sözleşmeyi kim yürütür</h2>
    <p class="mt-4 max-w-[68ch] text-body text-ink-60">
      Projeye bağlı olarak, ya tek bir tasarım-yapım sözleşmesi yürütürüz ya da zaten güvendiğiniz
      yüklenicileri koordine eden proje yöneticisi olarak çalışırız. Her iki durumda da ilk eskizden teslime
      kadar sorumlu olan aynı ekiptir — devredeceğiniz ayrı bir tasarım ofisi ya da devraldığınız ayrı bir
      yüklenici yoktur.
    </p>

    <h2 class="mt-14 text-h2">Tek ekip neden önemli</h2>
    <p class="mt-4 max-w-[68ch] text-body text-ink-60">
      Tasarım ve inşaat iki ayrı firmada olduğunda aralarında bir boşluk açılır — mimar kötü uygulamayı
      yükleniciye, yüklenici de uygulanamaz çizimleri mimara bağlar; müşteri ise kendisine ait olmayan bir
      anlaşmazlığı çözmek zorunda ortada kalır. Tek bir ekibin her ikisinden de sorumlu olması bu boşluğu
      kapatır: çizen ekiple inşa eden ekip aynı olduğunda, sorunlar yazışmalarda tartışılmak yerine sahada
      çözülür.
    </p>

    <h2 class="mt-14 text-h2">Sizden ihtiyacımız olanlar</h2>
    <ul class="mt-4 max-w-[68ch] list-disc space-y-2 pl-5 text-body text-ink-60">
      <li>Net bir brief — hedefler, kullanıcılar ve kısıtlar, mümkün olduğunca erken ve açık şekilde.</li>
      <li>Her aşamada zamanında kararlar, özellikle malzeme ve onaylarda — buradaki gecikmeler sonrasındaki her şeyi geciktirir.</li>
      <li>Sahaya erişim ve sahanın durumu/kısıtları hakkında gerçekçi bir bakış.</li>
      <li>Baştan gerçekçi bir bütçe aralığı, geliştirdiğimiz tasarımın gerçekten inşa edilebilir olması için.</li>
    </ul>
  </article>
</Layout>
