---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import SelectedWorksTeaser from '../../components/SelectedWorksTeaser.astro';
import { url } from '../../lib/url';
---

<Layout
  lang="tr"
  title="Omay Partners - Mimarlık, İç Mimarlık, Fitout, Uygulama, İnşaat"
  description="Mimari, iç mekân, uygulama ve proje yönetimi — Ankara merkezli, uluslararası çalışan bir ofis."
  translations={{ en: '/', tr: '/tr/' }}
>
  <Hero
    image="/images/site/hero/hero"
    widths={[1024, 1600, 2560]}
    width={2560}
    height={1620}
    alt="ODTÜ Teknokent Kuluçka Merkezi, Ankara — parktan görülen delikli panel cephe"
    credit="ODTÜ Teknokent Kuluçka Merkezi, Ankara — mimari: Omay Partners"
  />

  <section class="pt-10 pb-16 md:pt-12 md:pb-20 lg:pt-16 lg:pb-[104px]">
    <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)]">
      <h1 class="text-display max-w-[18ch] text-balance">
        Tasarım ve uygulama aynı ekipten.
      </h1>
      <p class="mt-6 max-w-[58ch] text-lead text-ink-60">
        Mimarlık, iç mimarlık ve uygulama. Ankara ve Atina merkezli; Türkiye, Avrupa, Orta Doğu
        ve Asya'da çalışıyoruz.
      </p>
      <div class="font-sans-nums mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-label uppercase">
        <a href={url('/tr/projeler/')} class="text-accent hover:opacity-70">Seçilmiş İşler →</a>
        <a href={url('/tr/iletisim/')} class="text-ink-60 hover:text-accent">İletişime geçin →</a>
      </div>
    </div>
  </section>

  <section class="border-t border-rule py-8 lg:py-10">
    <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] text-center">
      <p class="font-sans-nums text-stat text-ink-60 uppercase">25+ yıl · 140+ proje</p>
    </div>
  </section>

  <section class="border-t border-rule py-16 md:py-16 lg:py-[104px]">
    <div class="mx-auto max-w-[62ch] px-[clamp(24px,5vw,96px)] text-center">
      <p class="font-sans-nums text-label text-ink-60 uppercase">Referanslarımız</p>
    </div>
    <div class="mt-12">
      <ClientLogos />
    </div>
  </section>

  <SelectedWorksTeaser lang="tr" />

  <section class="border-t border-rule py-16 md:py-16 lg:py-[104px]">
    <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-x-8 gap-y-10 px-[clamp(24px,5vw,96px)] text-center md:grid-cols-3">
      <div class="border-t border-rule pt-6">
        <img
          src={url('/images/site/home/architecture.webp')}
          alt=""
          class="mx-auto aspect-[4/3] w-full max-w-[220px] object-cover"
          loading="lazy"
          decoding="async"
        />
        <h3 class="mt-4 text-h3">Mimari</h3>
        <p class="mt-2 text-body text-ink-60">Konsept tasarımdan uygulama projesine.</p>
      </div>
      <div class="border-t border-rule pt-6">
        <img
          src={url('/images/site/home/interior.webp')}
          alt=""
          class="mx-auto aspect-[4/3] w-full max-w-[220px] object-cover"
          loading="lazy"
          decoding="async"
        />
        <h3 class="mt-4 text-h3">İç Mekân</h3>
        <p class="mt-2 text-body text-ink-60">İnşa edilmek üzere tasarlanan mekânlar.</p>
      </div>
      <div class="border-t border-rule pt-6">
        <img
          src={url('/images/site/home/construction.webp')}
          alt=""
          class="mx-auto aspect-[4/3] w-full max-w-[220px] object-cover"
          loading="lazy"
          decoding="async"
        />
        <h3 class="mt-4 text-h3">Uygulama</h3>
        <p class="mt-2 text-body text-ink-60">Tasarımdan teslime tek ekip.</p>
      </div>
    </div>
    <div class="mt-10 text-center">
      <a href={url('/tr/nasil-teslim-ediyoruz/')} class="font-sans-nums text-label text-accent uppercase hover:opacity-70">
        Nasıl teslim ediyoruz →
      </a>
    </div>
  </section>

  <section class="border-t border-rule py-16 md:py-16 lg:py-[104px]">
    <div class="mx-auto max-w-[62ch] px-[clamp(24px,5vw,96px)] text-center">
      <p class="text-lead text-ink-60">
        İşin başından sonuna aynı ekibin takip ettiği küçük bir stüdyoyuz — ilk eskizi çizen el, anahtar
        teslimine kadar projenin yanında kalır. İşlerimizin büyük bölümü, yeniden birlikte çalışmak isteyen
        müşterilerimizden gelir. Binalar, iç mekânlar ve uygulamalar; sessizce ve zamanında teslim edilir.
      </p>
      <a href={url('/tr/hakkimizda/')} class="font-sans-nums mt-6 inline-block text-label text-accent uppercase hover:opacity-70">
        Hakkımızda →
      </a>
    </div>
  </section>
</Layout>
