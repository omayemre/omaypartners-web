---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectorTabs from '../../components/SectorTabs.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';

const projects = (
  await getCollection(
    'projects',
    ({ data }) => data.lang === 'en' && data.sector === 'diplomatic-institutional'
  )
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  lang="en"
  title="Diplomatic & Institutional"
  description="Embassies, schools and institutional buildings designed and delivered by Omay Partners."
  translations={{ en: '/sectors/diplomatic-institutional/', tr: '/tr/sektorler/diplomatik-kurumsal/' }}
>
  <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-section">
    <h1 class="text-center text-h1">Diplomatic &amp; Institutional</h1>
    <p class="mt-4 text-center text-lead text-ink-60">
      Embassies, schools and institutional buildings designed and delivered by Omay Partners.
    </p>
    <div class="mt-10">
      <SectorTabs lang="en" active="diplomatic-institutional" />
    </div>
    <div class="mt-12">
      <ProjectGrid projects={projects} lang="en" />
    </div>
  </div>
</Layout>
