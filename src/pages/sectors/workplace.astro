---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectorTabs from '../../components/SectorTabs.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';

const projects = (
  await getCollection('projects', ({ data }) => data.lang === 'en' && data.sector === 'workplace')
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  lang="en"
  title="Workplace"
  description="Offices and workplace projects designed and delivered by Omay Partners."
  translations={{ en: '/sectors/workplace/', tr: '/tr/sektorler/is-yerleri/' }}
>
  <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-section">
    <h1 class="text-center text-h1">Workplace</h1>
    <p class="mt-4 text-center text-lead text-ink-60">
      Offices and workplace projects designed and delivered by Omay Partners.
    </p>
    <div class="mt-10">
      <SectorTabs lang="en" active="workplace" />
    </div>
    <div class="mt-12">
      <ProjectGrid projects={projects} lang="en" />
    </div>
  </div>
</Layout>
