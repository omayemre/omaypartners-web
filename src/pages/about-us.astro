---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Emre Omay',
  jobTitle: 'Founding Partner',
  image: new URL(url('/images/site/about/emre-omay.webp'), Astro.site).href,
  worksFor: {
    '@type': 'Organization',
    name: 'Omay Partners',
    url: new URL(url('/'), Astro.site).href
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Middle East Technical University'
  },
  description:
    'An architect with 25+ years of international experience in architecture, construction and project delivery.'
};
---

<Layout
  lang="en"
  title="Studio"
  description="Omay Partners is an architecture, interior design, construction and project-delivery practice based in Ankara, Türkiye."
  translations={{ en: '/about-us/', tr: '/tr/hakkimizda/' }}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <article class="mx-auto max-w-[109ch] px-[clamp(24px,5vw,96px)] py-16 md:py-16 lg:py-[104px]">
    <h1 class="text-h1">Studio</h1>

    <p class="mt-8 text-lead text-ink-60">
      Omay Partners is an architecture, interior design, construction and project-delivery practice based in
      Ankara, Türkiye, working across Türkiye, the Middle East, Asia and Europe.
    </p>
    <p class="mt-4 text-lead text-ink-60">
      For over two decades we've designed and built across scales and sectors — hotels and mixed-use
      developments, embassies and institutional buildings, transport hubs, workplaces, clinics, and homes.
      Our clients include Sabancı, Hilton, Ericsson, Leonardo, Sandvik, and many embassies.
    </p>

    <img
      src={url('/images/site/studio/01.webp')}
      alt=""
      class="mt-10 aspect-[4/3] w-full max-w-xs object-cover"
      loading="lazy"
      decoding="async"
    />

    <h2 class="mt-12 text-h2">What we do</h2>
    <p class="mt-4 text-body text-ink-60">
      We carry a project from first sketch to handover, so a single team holds the through-line from idea to
      built reality:
    </p>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-body text-ink-60">
      <li><strong>Architecture &amp; interiors</strong> — concept design through detailed documentation.</li>
      <li><strong>Construction &amp; fit-out</strong> — delivery on site, to specification.</li>
      <li><strong>Project management</strong> — coordination, programme, and budget from start to completion.</li>
    </ul>

    <h2 class="mt-12 text-h2">How we work</h2>
    <div class="mt-4 flex items-start gap-5">
      <img
        src={url('/images/site/studio/02.webp')}
        alt=""
        class="aspect-[4/3] w-36 shrink-0 object-cover"
        loading="lazy"
        decoding="async"
      />
      <p class="text-body text-ink-60">
        Good design is the discipline of making a space work precisely for the people who use it. We start by
        understanding the brief, the site, and the constraints, then resolve them into something clear,
        rigorous, and quietly considered. We work closely with our clients and consultants, and we measure
        success by the long-term relationships that outlast the project itself.
      </p>
    </div>

    <h2 class="mt-12 text-h2">Leadership</h2>
    <div class="mt-4 flex items-start gap-5">
      <img src={url('/images/site/about/emre-omay.webp')} alt="Emre Omay" class="w-36 shrink-0" />
      <div>
        <p class="font-medium text-ink">Emre Omay — Founding Partner</p>
        <p class="mt-2 text-body text-ink-60">
          An architect with 25+ years of international experience in architecture, construction and project
          delivery, previously at Turner International and Sabancı Holding. Educated in architecture and
          management at Middle East Technical University (METU). He has led 100+ projects across Europe, Asia
          and the Middle East.
        </p>
        <p class="font-sans-nums mt-4 text-table text-ink-60">
          Selected clients: Sabancı, Hilton, Ericsson, Qatar Airways, BP, AECOM, Sandvik, Udemy, Securitas,
          Cushman &amp; Wakefield, Leonardo, Fulbright, Tüprag (Eldorado Gold), Limeks, METU — and many
          embassies, including the Italian, Netherlands, British, German, Norwegian and Maltese missions.
        </p>
      </div>
    </div>
  </article>
</Layout>
