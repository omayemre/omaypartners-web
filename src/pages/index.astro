---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClientLogos from '../components/ClientLogos.astro';
import SelectedWorksTeaser from '../components/SelectedWorksTeaser.astro';
import { url } from '../lib/url';
---

<Layout
  lang="en"
  title="Omay Partners - Architecture, Interior Design, Fit-Out, Construction"
  description="Architecture, interior design, construction and project delivery — Ankara, working internationally."
  translations={{ en: '/', tr: '/tr/' }}
>
  <Hero
    image="/images/site/hero/hero"
    widths={[1024, 1600, 2560]}
    width={2560}
    height={1620}
    alt="ODTÜ Teknokent Incubation Centre, Ankara — perforated screen facade seen from the park"
    credit="ODTÜ Teknokent Kuluçka Merkezi, Ankara — architecture by Omay Partners"
  />

  <section class="pt-10 pb-16 md:pt-12 md:pb-20 lg:pt-16 lg:pb-[104px]">
    <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)]">
      <h1 class="text-display max-w-[18ch] text-balance">
        Designed and built by the same hands.
      </h1>
      <p class="mt-6 max-w-[58ch] text-lead text-ink-60">
        Architecture, interiors and construction delivery. Ankara and Athens, working across
        Türkiye, Europe, the Middle East and Asia.
      </p>
      <div class="font-sans-nums mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-label uppercase">
        <a href={url('/selected-projects/')} class="text-accent hover:opacity-70">Selected Works →</a>
        <a href={url('/contact-us/')} class="text-ink-60 hover:text-accent">Get in touch →</a>
      </div>
    </div>
  </section>

  <section class="border-t border-rule py-8 lg:py-10">
    <div class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] text-center">
      <p class="font-sans-nums text-stat text-ink-60 uppercase">25+ years · 140+ projects</p>
    </div>
  </section>

  <section class="border-t border-rule py-16 md:py-16 lg:py-[104px]">
    <div class="mx-auto max-w-[62ch] px-[clamp(24px,5vw,96px)] text-center">
      <p class="font-sans-nums text-label text-ink-60 uppercase">Our Clients</p>
    </div>
    <div class="mt-12">
      <ClientLogos />
    </div>
  </section>

  <SelectedWorksTeaser lang="en" />

  <section class="border-t border-rule py-16 md:py-16 lg:py-[104px]">
    <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-x-8 gap-y-10 px-[clamp(24px,5vw,96px)] text-center md:grid-cols-3">
      <div class="border-t border-rule pt-6">
        <img
          src={url('/images/site/home/architecture.webp')}
          alt=""
          class="mx-auto aspect-[4/3] w-full max-w-[220px] object-cover"
          loading="lazy"
          decoding="async"
        />
        <h3 class="mt-4 text-h3">Architecture</h3>
        <p class="mt-2 text-body text-ink-60">From concept design to construction documents.</p>
      </div>
      <div class="border-t border-rule pt-6">
        <img
          src={url('/images/site/home/interior.webp')}
          alt=""
          class="mx-auto aspect-[4/3] w-full max-w-[220px] object-cover"
          loading="lazy"
          decoding="async"
        />
        <h3 class="mt-4 text-h3">Interior Design</h3>
        <p class="mt-2 text-body text-ink-60">Spaces designed to be built.</p>
      </div>
      <div class="border-t border-rule pt-6">
        <img
          src={url('/images/site/home/construction.webp')}
          alt=""
          class="mx-auto aspect-[4/3] w-full max-w-[220px] object-cover"
          loading="lazy"
          decoding="async"
        />
        <h3 class="mt-4 text-h3">Construction Delivery</h3>
        <p class="mt-2 text-body text-ink-60">One team, from design to handover.</p>
      </div>
    </div>
    <div class="mt-10 text-center">
      <a href={url('/how-we-deliver/')} class="font-sans-nums text-label text-accent uppercase hover:opacity-70">
        See how we deliver →
      </a>
    </div>
  </section>

  <section class="border-t border-rule py-16 md:py-16 lg:py-[104px]">
    <div class="mx-auto max-w-[62ch] px-[clamp(24px,5vw,96px)] text-center">
      <p class="text-lead text-ink-60">
        We are a small studio that stays close to the work — the hand that draws the first sketch stays with
        the project through handover. Most of our commissions come from clients who return. Buildings,
        interiors and fit-outs — delivered quietly, on time.
      </p>
      <a href={url('/about-us/')} class="font-sans-nums mt-6 inline-block text-label text-accent uppercase hover:opacity-70">
        About us →
      </a>
    </div>
  </section>
</Layout>
