---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClientLogos from '../components/ClientLogos.astro';
import SelectedWorksTeaser from '../components/SelectedWorksTeaser.astro';
import { url } from '../lib/url';
---

<Layout
  lang="en"
  title="Omay Partners"
  description="Architecture, interior design, construction and project delivery — Ankara, working internationally."
  translations={{ en: '/', tr: '/tr/' }}
>
  <Hero
    headline="Architecture, interiors, design and delivery."
    subhead="From first sketch to handover, under one roof."
    ctaLabel="Let's talk about your project"
    ctaHref={url('/contact-us/')}
  />

  <section class="bg-white py-16">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <p class="text-xs tracking-widest text-[#1a2233]/50 uppercase">Our Clients</p>
      <p class="mt-4 text-lg text-[#1a2233]/80">
        Omay Partners is a design and build practice with 25+ years of experience, bringing architecture,
        interior design and construction delivery under one roof. We carry projects from first sketch to
        handover across Ankara and Athens.
      </p>
    </div>
    <div class="mt-12">
      <ClientLogos />
    </div>
  </section>

  <SelectedWorksTeaser lang="en" />

  <section class="bg-white py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 text-center md:grid-cols-3">
      <div>
        <h3 class="text-lg">Architecture</h3>
        <p class="mt-2 text-sm text-[#1a2233]/60">From concept design to construction documents.</p>
      </div>
      <div>
        <h3 class="text-lg">Interior Design</h3>
        <p class="mt-2 text-sm text-[#1a2233]/60">Spaces designed to be built.</p>
      </div>
      <div>
        <h3 class="text-lg">Construction Delivery</h3>
        <p class="mt-2 text-sm text-[#1a2233]/60">One team, from design to handover.</p>
      </div>
    </div>
  </section>

  <section class="bg-[#f1ede6] py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="text-sm tracking-wide text-[#1a2233]/50 uppercase">25+ years · 140+ projects · Ankara–Athens</p>
      <p class="mt-6 text-lg text-[#1a2233]/80">
        We are a small studio that stays close to the work — the hand that draws the first sketch stays with
        the project through handover. Most of our commissions come from clients who return. Buildings,
        interiors and fit-outs — delivered quietly, on time.
      </p>
      <a href={url('/about-us/')} class="mt-6 inline-block text-sm tracking-wide text-[#1a2233] uppercase hover:underline">
        About us →
      </a>
    </div>
  </section>
</Layout>
