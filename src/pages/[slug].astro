---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FactBlock from '../components/FactBlock.astro';
import { url } from '../lib/url';
import { projectImage } from '../lib/img';
import referenceRows from '../data/references.en.json';

export async function getStaticPaths() {
  const enProjects = (await getCollection('projects', ({ data }) => data.lang === 'en')).sort(
    (a, b) => a.data.order - b.data.order
  );
  const trProjects = await getCollection('projects', ({ data }) => data.lang === 'tr');

  return enProjects.map((project, i) => {
    const trCounterpart = trProjects.find((p) => p.data.translationKey === project.data.translationKey);
    const prev = enProjects[i - 1];
    const next = enProjects[i + 1];
    return {
      params: { slug: project.data.slug },
      props: {
        project,
        trSlug: trCounterpart?.data.slug,
        prev: prev && { title: prev.data.title, slug: prev.data.slug },
        next: next && { title: next.data.title, slug: next.data.slug }
      }
    };
  });
}

const { project, trSlug, prev, next } = Astro.props;
const { title, cover, gallery, client, location, year, area, note } = project.data;
const description = client
  ? `${title} — a project for ${client}${location ? ` in ${location}` : ''}. Design and construction by Omay Partners.`
  : `${title} — design and construction by Omay Partners.`;

// "Service Provided" is only in the Archive dataset, joined here by slug -
// only the ~35 rows that were confidently matched carry it.
const referenceRow = referenceRows.find((r) => !r.section && r.slug === project.data.slug);
const service = referenceRow && referenceRow.service !== '*' ? referenceRow.service : undefined;

const coverImg = cover ? projectImage(cover) : null;
const galleryImgs = gallery ? gallery.slice(1).map(projectImage) : [];

const creativeWorkSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  ...(cover ? { image: new URL(url(cover), Astro.site).href } : {}),
  ...(client ? { about: { '@type': 'Organization', name: client } } : {}),
  ...(location ? { locationCreated: { '@type': 'Place', name: location } } : {}),
  ...(year ? { dateCreated: year } : {}),
  creator: { '@type': 'Organization', name: 'Omay Partners', url: new URL(url('/'), Astro.site).href }
};
---

<Layout
  lang="en"
  title={title}
  description={description}
  translations={{ en: `/${project.data.slug}/`, ...(trSlug ? { tr: `/tr/${trSlug}/` } : {}) }}
  image={cover ? url(cover) : undefined}
  breadcrumbs={[{ name: 'Selected Works', path: '/selected-projects/' }, { name: title, path: `/${project.data.slug}/` }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(creativeWorkSchema)} />
  <article class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-section">
    <h1 class="text-center text-h1">{title}</h1>

    <FactBlock lang="en" client={client} location={location} year={year} area={area} service={service} />

    {note && <p class="mt-4 text-center text-table italic text-ink-60">{note}</p>}

    {coverImg && (
      <div class="mt-10">
        <img
          src={coverImg.src}
          srcset={coverImg.srcset}
          sizes="(min-width: 1440px) 1248px, 100vw"
          alt={title}
          width={coverImg.width ?? 1200}
          height={coverImg.height ?? 800}
          class="aspect-[3/2] w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    {galleryImgs.length > 0 && (
      <div class="mx-auto mt-10 grid max-w-[1200px] grid-cols-2 gap-4 sm:gap-6">
        {galleryImgs.map((img) => (
          <img
            src={img.src}
            srcset={img.srcset}
            sizes="(min-width: 1200px) 588px, 45vw"
            alt=""
            width={img.width ?? 900}
            height={img.height ?? 600}
            class="aspect-[3/2] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    )}

    <nav
      class="font-sans-nums mt-14 flex flex-col items-center gap-3 border-t border-rule pt-8 text-center text-label uppercase sm:flex-row sm:justify-between sm:gap-6 sm:text-left"
      aria-label="Project navigation"
    >
      <div class="order-2 sm:order-1 sm:flex-1">
        {prev && (
          <a href={url(`/${prev.slug}/`)} class="text-ink-60 hover:text-accent">
            ← {prev.title}
          </a>
        )}
      </div>
      <a href={url('/selected-projects/')} class="order-1 shrink-0 text-ink-60 hover:text-accent sm:order-2">
        All projects
      </a>
      <div class="order-3 sm:flex-1 sm:text-right">
        {next && (
          <a href={url(`/${next.slug}/`)} class="text-ink-60 hover:text-accent">
            {next.title} →
          </a>
        )}
      </div>
    </nav>

    <div class="mt-8 text-center">
      <a href={url('/contact-us/')} class="font-sans-nums text-label text-accent uppercase hover:opacity-70">
        Discuss a similar project →
      </a>
    </div>
  </article>
</Layout>
