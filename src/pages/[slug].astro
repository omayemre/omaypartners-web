---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FactBlock from '../components/FactBlock.astro';
import { url } from '../lib/url';

export async function getStaticPaths() {
  const enProjects = await getCollection('projects', ({ data }) => data.lang === 'en');
  const trProjects = await getCollection('projects', ({ data }) => data.lang === 'tr');

  return enProjects.map((project) => {
    const trCounterpart = trProjects.find((p) => p.data.translationKey === project.data.translationKey);
    return {
      params: { slug: project.data.slug },
      props: { project, trSlug: trCounterpart?.data.slug }
    };
  });
}

const { project, trSlug } = Astro.props;
const { title, cover, gallery, client, location, year, area } = project.data;
const description = client
  ? `${title} — a project for ${client}${location ? ` in ${location}` : ''}. Architecture, interior design and construction delivery by Omay Partners.`
  : `${title} — architecture, interior design and construction delivery by Omay Partners.`;
---

<Layout
  lang="en"
  title={title}
  description={description}
  translations={{ en: `/${project.data.slug}/`, ...(trSlug ? { tr: `/tr/${trSlug}/` } : {}) }}
  image={cover ? url(cover) : undefined}
>
  <article class="mx-auto max-w-[1440px] px-[clamp(24px,5vw,96px)] py-16 md:py-16 lg:py-[104px]">
    <h1 class="text-center text-h1">{title}</h1>

    <FactBlock lang="en" client={client} location={location} year={year} area={area} />

    {cover && (
      <div class="mt-10">
        <img src={url(cover)} alt={title} class="aspect-[3/2] w-full object-cover" loading="eager" decoding="async" />
      </div>
    )}

    {gallery && gallery.length > 1 && (
      <div class="mx-auto mt-10 max-w-2xl space-y-6">
        {gallery.slice(1).map((src) => (
          <img src={url(src)} alt="" class="mx-auto max-h-[80vh] w-full object-contain" loading="lazy" decoding="async" />
        ))}
      </div>
    )}

    <div class="mt-12 text-center">
      <a href={url('/selected-projects/')} class="font-sans-nums text-label text-ink-60 uppercase hover:text-accent">
        ← All projects
      </a>
    </div>
  </article>
</Layout>
